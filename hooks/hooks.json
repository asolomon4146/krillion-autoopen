{
  "description": "Open Krillion Puffer Party when Claude starts working on a prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/open-krillion.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
